  "kpis": [
    {
      "id": "net_revenue",
      "name": "Net Revenue",
      "definition": "Settled sales and refunds for real customers, excluding voided payments and test accounts.",
      "formula": "sum(fct_payments.amount_cents) / 100",
      "grain": "location x month",
      "tier": "board",
      "unit": "currency",
      "source": "metrics.kpi_location_monthly.net_revenue"
    },
    {
      "id": "membership_revenue",
      "name": "Membership Revenue",
      "definition": "Net revenue from recurring membership charges.",
      "formula": "sum(amount_cents) where revenue_stream = 'membership'",
      "grain": "location x month",
      "tier": "board",
      "unit": "currency",
      "source": "metrics.kpi_location_monthly.membership_revenue"
    },
    {
      "id": "service_revenue",
      "name": "Service Revenue",
      "definition": "Net revenue from individual services, including refunds of those services.",
      "formula": "sum(amount_cents) where revenue_stream = 'service'",
      "grain": "location x month",
      "tier": "executive",
      "unit": "currency",
      "source": "metrics.kpi_location_monthly.service_revenue"
    },
    {
      "id": "active_members",
      "name": "Active Members",
      "definition": "Memberships active at any point in the month, including those that start or end in it.",
      "formula": "count(fct_membership_months rows)",
      "grain": "location x month",
      "tier": "board",
      "unit": "count",
      "source": "metrics.kpi_location_monthly.active_members"
    },
    {
      "id": "new_members",
      "name": "New Members",
      "definition": "Memberships whose start date falls in the month.",
      "formula": "count where is_new",
      "grain": "location x month",
      "tier": "executive",
      "unit": "count",
      "source": "metrics.kpi_location_monthly.new_members"
    },
    {
      "id": "member_churn_rate",
      "name": "Member Churn Rate",
      "definition": "Memberships ending in the month divided by memberships active at the start of the month.",
      "formula": "churned_members / (active_members - new_members)",
      "grain": "location x month",
      "tier": "board",
      "unit": "percent",
      "source": "metrics.kpi_location_monthly.member_churn_rate"
    },
    {
      "id": "completed_visits",
      "name": "Completed Visits",
      "definition": "Appointments with a completed status for real customers.",
      "formula": "count(fct_appointments) where status = 'completed'",
      "grain": "location x month",
      "tier": "executive",
      "unit": "count",
      "source": "metrics.kpi_location_monthly.completed_visits"
    },
    {
      "id": "no_show_rate",
      "name": "No-Show Rate",
      "definition": "No-show appointments divided by all scheduled appointments in the month.",
      "formula": "no_shows / appointments_scheduled",
      "grain": "location x month",
      "tier": "operational",
      "unit": "percent",
      "source": "metrics.kpi_location_monthly.no_show_rate"
    },
    {
      "id": "revenue_per_visit",
      "name": "Revenue per Visit",
      "definition": "Service revenue divided by completed visits. Membership revenue is excluded.",
      "formula": "service_revenue / completed_visits",
      "grain": "location x month",
      "tier": "operational",
      "unit": "currency",
      "source": "metrics.kpi_location_monthly.revenue_per_visit"
    },
    {
      "id": "lead_conversion_rate",
      "name": "Lead Conversion Rate",
      "definition": "Leads created in the month that became real customers, divided by all leads created in the month.",
      "formula": "converted_leads / leads",
      "grain": "location x month",
      "tier": "executive",
      "unit": "percent",
      "source": "metrics.kpi_location_monthly.lead_conversion_rate"
    }
  ]
}